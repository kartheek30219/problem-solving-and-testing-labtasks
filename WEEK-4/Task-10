import static java.util.stream.Collectors.joining;
import static java.util.stream.Collectors.toList;

class Result {
 public static void matrixRotation(List<List<Integer>> matrix, int r) {
int m = matrix.size();
        int n = matrix.get(0).size();

        // Number of layers
        int layers = Math.min(m, n) / 2;

        for (int layer = 0; layer < layers; layer++) {

            List<Integer> temp = new ArrayList<>();

            int top = layer;
            int left = layer;
            int bottom = m - layer - 1;
            int right = n - layer - 1;

            // Top row
            for (int j = left; j <= right; j++)
                temp.add(matrix.get(top).get(j));

            // Right column
            for (int i = top + 1; i <= bottom; i++)
                temp.add(matrix.get(i).get(right));

            // Bottom row
            for (int j = right - 1; j >= left; j--)
                temp.add(matrix.get(bottom).get(j));

            // Left column
            for (int i = bottom - 1; i > top; i--)
                temp.add(matrix.get(i).get(left));

            int len = temp.size();
            int shift = r % len;

            // Anti-clockwise rotation
            List<Integer> rotated = new ArrayList<>();
            for (int i = shift; i < len; i++)
                rotated.add(temp.get(i));

            for (int i = 0; i < shift; i++)
                rotated.add(temp.get(i));

            int k = 0;

            // Top row
            for (int j = left; j <= right; j++)
                matrix.get(top).set(j, rotated.get(k++));

            // Right column
            for (int i = top + 1; i <= bottom; i++)
                matrix.get(i).set(right, rotated.get(k++));

            // Bottom row
            for (int j = right - 1; j >= left; j--)
                matrix.get(bottom).set(j, rotated.get(k++));

            // Left column
            for (int i = bottom - 1; i > top; i--)
                matrix.get(i).set(left, rotated.get(k++));
        }

        // Print matrix
        for (List<Integer> row : matrix) {
            for (int i = 0; i < row.size(); i++) {
                System.out.print(row.get(i));
                if (i < row.size() - 1)
                    System.out.print(" ");
            }
            System.out.println();
        }
    }

}

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(System.in));

        String[] firstMultipleInput = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");

        int m = Integer.parseInt(firstMultipleInput[0]);

        int n = Integer.parseInt(firstMultipleInput[1]);

        int r = Integer.parseInt(firstMultipleInput[2]);

        List<List<Integer>> matrix = new ArrayList<>();

        IntStream.range(0, m).forEach(i -> {
            try {
                matrix.add(
                    Stream.of(bufferedReader.readLine().replaceAll("\\s+$", "").split(" "))
                        .map(Integer::parseInt)
                        .collect(toList())
                );
            } catch (IOException ex) {
                throw new RuntimeException(ex);
            }
        });

        Result.matrixRotation(matrix, r);

        bufferedReader.close();
    }
}
